{
  "name": "a11y-crawl",
  "version": "0.1.0",
  "description": "Crawls a site and performs an accessibility scan on every unique path",
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/src/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdwall3r/a11y-crawl.git"
  },
  "keywords": [
    "accessibility",
    "audit",
    "scan",
    "a11y"
  ],
  "author": "Ryan Waller",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/rdwall3r/a11y-crawl/issues"
  },
  "homepage": "https://github.com/rdwall3r/a11y-crawl#readme",
  "bin": {
    "a11y-crawl": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.1",
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  }
}
